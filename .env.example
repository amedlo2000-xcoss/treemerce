# Supabase プロジェクトの接続情報
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role キー (サーバー専用。NEXT_PUBLIC_ を付けないこと)。
# 使うのは代理店登録リンクの申し込み API (src/lib/supabase/admin.ts) で、
# メール確認済みのアカウントを作成する・申し込みに失敗したときに削除する、の2つだけ。
# テーブルの読み書き・RPC には使わない (RLS を迂回する経路を作らないため)。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
